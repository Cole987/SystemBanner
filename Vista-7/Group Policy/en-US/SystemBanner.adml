<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>
  </displayName>
  <description>
  </description>
  <resources>
    <stringTable>
      <string id="unknown_0">SystemBanner</string>
      <string id="unknown_1">Set Simple Classification Setting</string>
      <string id="unknown_2">When this setting is enabled, the classification level selected will be shown. When set to UNCONFIGURED, not configured or disabled, the simple classification will be unconfigured and custom settings can be used. The classifications are grouped by system: United States, France, Germany, United Kingdom, NATO and United Nations. National colors are used where an official text sets them (United States, France, Germany), NATO follows a common unofficial convention, the other classifications are shown in white on black.</string>
      <string id="unknown_3">Top Only</string>
      <string id="unknown_4">UNCONFIGURED</string>
      <string id="unknown_5">United States – UNCLASSIFIED</string>
      <string id="unknown_6">United States – CUI</string>
      <string id="unknown_7">United States – CONFIDENTIAL</string>
      <string id="unknown_8">United States – SECRET</string>
      <string id="unknown_9">United States – TOP SECRET</string>
      <string id="unknown_10">United States – TOP SECRET//SCI</string>
      <string id="Preset_11">France – DIFFUSION RESTREINTE</string>
      <string id="Preset_12">France – SECRET</string>
      <string id="Preset_13">France – TRÈS SECRET</string>
      <string id="Preset_21">Germany – VS-NUR FÜR DEN DIENSTGEBRAUCH</string>
      <string id="Preset_22">Germany – VS-VERTRAULICH</string>
      <string id="Preset_23">Germany – GEHEIM</string>
      <string id="Preset_24">Germany – STRENG GEHEIM</string>
      <string id="Preset_31">United Kingdom – OFFICIAL</string>
      <string id="Preset_32">United Kingdom – OFFICIAL-SENSITIVE</string>
      <string id="Preset_33">United Kingdom – SECRET</string>
      <string id="Preset_34">United Kingdom – TOP SECRET</string>
      <string id="Preset_41">NATO – NATO UNCLASSIFIED</string>
      <string id="Preset_42">NATO – NATO RESTRICTED</string>
      <string id="Preset_43">NATO – NATO CONFIDENTIAL</string>
      <string id="Preset_44">NATO – NATO SECRET</string>
      <string id="Preset_45">NATO – COSMIC TOP SECRET</string>
      <string id="Preset_51">United Nations – UN CONFIDENTIAL</string>
      <string id="Preset_52">United Nations – UN STRICTLY CONFIDENTIAL</string>
      <string id="unknown_11">Set Custom Background Color</string>
      <string id="unknown_12">When Set Simple Classification Setting is set to UNCONFIGURED, not configured or disabled, and this setting is defined, this custom color value is displayed in the Background.</string>
      <string id="unknown_13">Set Banner Position Setting</string>
      <string id="unknown_14">When this setting is enabled, the banner positions selected will be shown. When set to UNCONFIGURED, not configured or disabled, only the top banner will display.</string>
      <string id="unknown_15">Top And Bottom</string>
      <string id="unknown_16">Set Custom Foreground Color</string>
      <string id="unknown_17">When Set Simple Classification Setting is set to UNCONFIGURED, not configured or disabled, and this setting is defined, this custom color value is displayed in the Foreground.</string>
      <string id="unknown_21">Set Custom Text</string>
      <string id="unknown_22">When Set Simple Classification Setting is set to UNCONFIGURED, not configured or disabled, and this setting is defined, this custom text value is displayed in the Foreground.</string>
      <string id="SystemBanner_UnresolvedString">The ADMX encountered a string that is not defined.</string>
      <string id="SystemBanner_SupportedOn">At least Windows Vista SP2.</string>
    </stringTable>
    <presentationTable>
      <presentation id="SetSimpleClassificationSetting">
        <dropdownList refId="SimpleClassificationSetting" defaultItem="0">Simple Classification Setting</dropdownList>
      </presentation>
      <presentation id="SetBannerPositionSetting">
        <dropdownList refId="BannerPositionSetting" defaultItem="0">Banner Position Setting</dropdownList>
      </presentation>
      <presentation id="SetCustomBackgroundColor">
        <decimalTextBox refId="RedBackgroundColorValueinDecimal0-255">Red Background Color Value in Decimal (0-255)</decimalTextBox>
        <decimalTextBox refId="GreenBackgroundColorValueinDecimal0-255">Green Background Color Value in Decimal (0-255)</decimalTextBox>
        <decimalTextBox refId="BlueBackgroundColorValueinDecimal0-255">Blue Background Color Value in Decimal (0-255)</decimalTextBox>
      </presentation>
      <presentation id="SetCustomForegroundColor">
        <decimalTextBox refId="RedForegroundColorValueinDecimal0-255">Red Foreground Color Value in Decimal (0-255)</decimalTextBox>
        <decimalTextBox refId="GreenForegroundColorValueinDecimal0-255">Green Foreground Color Value in Decimal (0-255)</decimalTextBox>
        <decimalTextBox refId="BlueForegroundColorValueinDecimal0-255">Blue Foreground Color Value in Decimal (0-255)</decimalTextBox>
      </presentation>
      <presentation id="SetCustomText">
        <textBox refId="ForegroundText">
          <label>Foreground Text</label>
          <defaultValue>0</defaultValue>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>