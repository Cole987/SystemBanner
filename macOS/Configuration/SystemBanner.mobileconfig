<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SystemBanner configuration profile, for Mac OS X 10.7 Lion and later (on 10.6 use MCX, defaults or SystemBanner Settings, see README).
     Edit the values under mcx_preference_settings, then install it with the Profiles preference pane or your MDM.
     Simple (overrides the custom settings): 0 unconfigured,
       United States: 1 UNCLASSIFIED, 2 CUI, 3 CONFIDENTIAL, 4 SECRET, 5 TOP SECRET, 6 TOP SECRET//SCI,
       France: 11 DIFFUSION RESTREINTE, 12 SECRET, 13 TRÈS SECRET,
       Germany: 21 VS-NUR FÜR DEN DIENSTGEBRAUCH, 22 VS-VERTRAULICH, 23 GEHEIM, 24 STRENG GEHEIM,
       United Kingdom: 31 OFFICIAL, 32 OFFICIAL-SENSITIVE, 33 SECRET, 34 TOP SECRET,
       NATO: 41 NATO UNCLASSIFIED, 42 NATO RESTRICTED, 43 NATO CONFIDENTIAL, 44 NATO SECRET, 45 COSMIC TOP SECRET,
       United Nations: 51 UN CONFIDENTIAL, 52 UN STRICTLY CONFIDENTIAL.
     Custom settings instead of Simple: "0" "1" "2" background red green blue, "3" "4" "5" text red green blue (0-255), "Text".
     ArrangeWindows: 1 moves the windows of other apps out from under the banners, needs the Accessibility access (see README). -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadContent</key>
			<dict>
				<key>com.systembanner</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>Simple</key>
								<integer>1</integer>
								<key>TopAndBottom</key>
								<integer>0</integer>
								<key>Debug</key>
								<integer>0</integer>
								<key>ArrangeWindows</key>
								<integer>0</integer>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
			<key>PayloadDisplayName</key>
			<string>SystemBanner</string>
			<key>PayloadIdentifier</key>
			<string>com.systembanner.profile.settings</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>C560557D-8F7E-43EC-9F1E-5393A0D43106</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Sets the classification shown by SystemBanner.</string>
	<key>PayloadDisplayName</key>
	<string>SystemBanner</string>
	<key>PayloadIdentifier</key>
	<string>com.systembanner.profile</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>846C5E3B-51D1-48D1-9798-72165F3E60A7</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
